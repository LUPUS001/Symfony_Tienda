{# templates/partials/_products.html.twig #}

<div class="owl-carousel product-carousel">
    {% for product in products %}
        <div class="pb-5">
            <div class="product-item position-relative bg-light d-flex flex-column text-center">
                {# FOTO DINÁMICA #}
                <img class="img-fluid mb-4" src="{{ asset('img/' ~ product.photo) }}" alt="{{ product.name }}">
                
                {# NOMBRE DINÁMICO #}
                <h6 class="text-uppercase">{{ product.name }}</h6>
                
                {# PRECIO DINÁMICO #}
                <h5 class="text-primary mb-0">{{ product.price }} €</h5>
                
                <div class="btn-action d-flex justify-content-center">
                    <a class="btn btn-primary py-2 px-3" href=""><i class="bi bi-cart"></i></a>
                    <a class="btn btn-primary py-2 px-3 open-info-product" data-id="{{product.id}}"><i class="bi bi-eye"></i></a>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
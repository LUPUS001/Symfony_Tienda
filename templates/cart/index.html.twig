{% extends 'base.html.twig' %}

{% block title %}Carrito de la compra{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h2 class="mb-4 text-uppercase">Carrito de la compra</h2>

            {% if items is empty %}
                <div class="alert alert-info">
                    El carrito está vacío.
                </div>
            {% else %}
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Precio</th>
                            <th>Cantidad</th>
                            <th>Total</th>
                            <th>Eliminar</th> {# 1. Nueva columna para eliminar #}
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                        {# 2. Añadimos el ID dinámico a la fila para que jQuery sepa qué borrar #}
                            <tr id="item-{{ item.id }}">
                                <td>
                                    <img src="{{ asset('img/' ~ item.photo) }}" style="width: 50px" class="me-2">
                                    {{ item.name }}
                                </td>
                                <td>{{ item.price }} €</td>
                                <td>{{ item.quantity }}</td>
                                <td>{{ item.price * item.quantity }} €</td>
                                <td>
                                    {# 3. Botón con clase 'btn-delete' y el ID del producto #}
                                    <button class="btn btn-sm btn-danger btn-delete" data-id="{{ item.id }}">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                
                <div class="text-end mt-4">
                    <h3 id="cart-total">Total: {{ totalCart }} €</h3>
                    <a href="#" class="btn btn-success">Tramitar pedido</a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}